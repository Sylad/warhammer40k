{
  "name": "warhammer40k-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "ng serve --port 4201",
    "build": "ng build && node scripts/plan-data.mjs --leaks dist/frontend/browser",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:watch": "vitest",
    "news": "rm -rf public/nouveautes-data && cadence news build -o public/nouveautes-data && rm -f public/nouveautes-data/index.html && node scripts/nouveautes-tailles.mjs",
    "plan": "node scripts/plan-data.mjs",
    "veille": "node scripts/veille-data.mjs",
    "liens": "node scripts/liens.mjs",
    "liens:crawl": "node scripts/liens-crawl.mjs",
    "liens:externes": "node scripts/liens-externes.mjs",
    "densite": "node scripts/densite.mjs"
  },
  "dependencies": {
    "@angular/animations": "^20.3.35",
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/forms": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "@angular/platform-browser-dynamic": "^20.3.35",
    "@angular/router": "^20.3.35",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.43",
    "@angular/cli": "^20.3.43",
    "@angular/compiler-cli": "^20.3.35",
    "@types/node": "^22.20.5",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
