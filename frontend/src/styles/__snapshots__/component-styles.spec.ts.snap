    "box-shadow": "0 22px 60px rgba(0, 0, 0, 0.6), 0 0 32px rgba(201, 162, 74, 0.12)",
    "transform": "translateY(-4px)",
  },
  ".category-card:hover::before": {
    "filter": "contrast(1.35) saturate(1.05) brightness(0.88)",
    "transform": "scale(1.06)",
  },
  ".category-grid": {
    "display": "grid",
    "gap": "12px",
    "grid-template-columns": "repeat(6, minmax(0, 1fr))",
  },
  ".chip": {
    "align-items": "center",
    "background": "rgba(201, 162, 74, 0.18)",
    "border": "1px solid rgba(201, 162, 74, 0.5)",
    "color": "var(--gold-bright)",
    "display": "inline-flex",
    "font-size": "12px",
    "font-weight": "700",
    "gap": "4px",
    "letter-spacing": "0.04em",
    "padding": "3px 4px 3px 9px",
  },
  ".chip-add": {
    "background": "rgba(201, 162, 74, 0.12)",
    "border": "1px solid rgba(201, 162, 74, 0.5)",
    "color": "var(--gold-bright)",
    "cursor": "pointer",
    "display": "grid",
    "font-family": "inherit",
    "font-size": "14px",
    "height": "26px",
    "place-items": "center",
    "width": "26px",
  },
  ".chip-add:hover": {
    "background": "rgba(201, 162, 74, 0.22)",
  },
  ".chip-input": {
    "align-items": "center",
    "background": "rgba(5, 4, 3, 0.78)",
    "border": "1px solid rgba(201, 162, 74, 0.32)",
    "display": "flex",
    "flex-wrap": "wrap",
    "gap": "6px",
    "min-height": "38px",
    "padding": "6px 8px",
  },
  ".chip-input input": {
    "background": "transparent",
    "border": "0",
    "color": "var(--text)",
    "flex": "1",
    "font-family": "inherit",
    "font-size": "13px",
    "height": "26px",
    "min-width": "120px",
    "outline": "none",
  },
  ".chip-x": {
    "background": "transparent",
    "border": "0",
    "color": "var(--gold)",
    "cursor": "pointer",
    "display": "grid",
    "font-family": "inherit",
    "font-size": "14px",
    "height": "18px",
    "place-items": "center",
    "width": "18px",
  },
  ".chip-x:hover": {
    "color": "#ff5c6b",
  },
  ".close": {
    "background": "rgba(0, 0, 0, 0.7)",
    "border": "1px solid rgba(201, 162, 74, 0.45)",
    "color": "var(--gold-bright)",
    "cursor": "pointer",
    "font-family": "inherit",
    "font-size": "22px",
    "height": "40px",
    "position": "absolute",
    "right": "18px",
    "top": "18px",
    "width": "40px",
    "z-index": "102",
  },
  ".close:hover": {
    "border-color": "var(--gold)",
  },
  ".col-icon": {
    "background": "rgba(201, 162, 74, 0.08)",
    "border": "1px solid rgba(201, 162, 74, 0.26)",
    "color": "var(--gold)",
    "display": "grid",
    "font-size": "14px",
    "height": "32px",
    "place-items": "center",
    "width": "32px",
  },
  ".col-info": {
    "display": "flex",
    "flex-direction": "column",
    "min-width": "0",
  },
  ".col-info small": {
    "color": "var(--muted)",
    "font-size": "11px",
  },
  ".col-info strong": {
    "color": "#ead7a2",
    "font-size": "13px",
    "font-weight": "700",
    "overflow": "hidden",
    "text-overflow": "ellipsis",
    "white-space": "nowrap",
  },
  ".col-row": {
    "align-items": "center",
    "background": "transparent",
    "border": "0",
    "border-top": "1px solid rgba(201, 162, 74, 0.12)",
    "color": "inherit",
    "cursor": "pointer",
    "display": "grid",
    "font-family": "inherit",
    "gap": "10px",
    "grid-template-columns": "32px 1fr",
    "padding": "8px 0",
    "text-align": "left",
    "transition": "color 0.15s ease",
    "width": "100%",
  },
  ".col-row.active": {
    "color": "var(--gold-bright)",
  },
  ".col-row:first-of-type": {
    "border-top": "0",
  },
  ".col-row:hover": {
    "color": "var(--gold-bright)",
  },
  ".empty": {
    "background": "rgba(8, 7, 6, 0.4)",
    "border": "1px dashed rgba(201, 162, 74, 0.3)",
    "color": "var(--muted)",
    "padding": "60px 24px",
    "text-align": "center",
  },
  ".empty-mini": {
    "color": "var(--muted)",
    "font-size": "12px",
    "font-style": "italic",
  },
  ".eyebrow": {
    "color": "var(--gold)",
    "display": "block",
    "font-size": "12px",
    "font-weight": "950",
    "letter-spacing": "0.18em",
    "margin-bottom": "10px",
    "text-transform": "uppercase",
  },
  ".filter-row": {
    "display": "flex",
    "flex-direction": "column",
    "gap": "6px",
    "margin-bottom": "12px",
  },
  ".filter-row label": {
    "color": "var(--muted)",
    "font-size": "10px",
    "font-weight": "700",
    "letter-spacing": "0.14em",
    "text-transform": "uppercase",
  },
  ".filter-row select": {
    "background": "rgba(5, 4, 3, 0.78)",
    "border": "1px solid rgba(201, 162, 74, 0.28)",
    "color": "var(--text)",
    "font-family": "inherit",
    "font-size": "13px",
    "height": "36px",
    "outline": "none",
    "padding": "0 10px",
  },
  ".filter-row select:focus": {
    "border-color": "var(--border-strong)",
  },
  ".filter-row select:focus-visible": {
    "outline": "2px solid var(--gold-bright)",
    "outline-offset": "3px",
  },
  ".filter-row:last-child": {
    "margin-bottom": "0",
  },
  ".gallery-page": {
    "margin": "0 auto",
    "padding": "28px 0 64px",
    "width": "min(1440px, 100% - 64px)",
  },
  ".hero": {
    "background": "var(--panel)",
    "border": "1px solid var(--border)",
    "box-shadow": "var(--shadow), inset 0 0 110px rgba(201, 162, 74, 0.045)",
    "margin-bottom": "28px",
    "min-height": "320px",
    "overflow": "hidden",
    "position": "relative",
  },
  ".hero h1": {
    "color": "var(--gold-bright)",
    "font-family": "var(--serif)",
    "font-size": "clamp(40px, 5vw, 68px)",
    "letter-spacing": "0.05em",
    "line-height": "0.95",
    "margin": "0 0 14px",
    "text-shadow": "0 2px 14px rgba(0, 0, 0, 0.85), 0 0 38px rgba(201, 162, 74, 0.28)",
    "text-transform": "uppercase",
  },
  ".hero-bg": {
    "background-position": "center",
    "background-size": "cover",
    "filter": "contrast(1.42) saturate(0.92) brightness(0.55)",
    "inset": "0",
    "position": "absolute",
    "transform": "scale(1.03)",
  },
  ".hero-content": {
    "align-items": "end",
    "display": "grid",
    "gap": "26px",
    "grid-template-columns": "minmax(0, 1.1fr) auto",
    "min-height": "320px",
    "padding": "36px 40px",
    "position": "relative",
    "z-index": "1",
  },
  ".hero-desc": {
    "color": "#cfc3ad",
    "font-size": "16px",
    "line-height": "1.65",
    "margin": "0 0 22px",
    "max-width": "620px",
  },
  ".hero-stats": {
    "display": "grid",
    "gap": "18px",
    "grid-template-columns": "repeat(3, 1fr)",
  },
  ".import-box": {
    "background": "linear-gradient(180deg, rgba(19, 15, 11, 0.98), rgba(5, 4, 3, 0.99))",
    "border": "1px solid rgba(201, 162, 74, 0.42)",
    "box-shadow": "0 30px 90px rgba(0, 0, 0, 0.85)",
    "max-height": "90vh",
    "overflow-y": "auto",
    "padding": "28px 26px 22px",
    "position": "relative",
    "width": "min(900px, 100% - 32px)",
  },
  ".import-box h3": {
    "color": "var(--gold-bright)",
    "font-size": "22px",
    "margin": "0 0 8px",
  },
  ".import-btn": {
    "font-size": "11px",
    "height": "32px",
    "justify-self": "stretch",
  },
  ".import-btn-hero": {
    "align-items": "center",
    "background": "rgba(201, 162, 74, 0.12)",
    "border": "1px solid var(--gold)",
    "color": "var(--gold-bright)",
    "cursor": "pointer",
    "display": "inline-flex",
    "font-family": "inherit",
    "font-size": "12px",
    "font-weight": "900",
    "gap": "6px",
    "height": "44px",
    "letter-spacing": "0.14em",
    "padding": "0 18px",
    "text-transform": "uppercase",
    "transition": "background 0.15s ease",
    "white-space": "nowrap",
  },
  ".import-btn-hero span": {
    "font-size": "16px",
    "line-height": "1",
  },
  ".import-btn-hero:hover": {
    "background": "rgba(201, 162, 74, 0.22)",
  },
  ".import-btn:disabled": {
    "cursor": "wait",
    "opacity": "0.5",
  },
  ".import-content": {
    "min-height": "200px",
  },
  ".import-message": {
    "background": "rgba(15, 107, 67, 0.15)",
    "border": "1px solid rgba(15, 107, 67, 0.5)",
    "color": "#80e0ad",
    "font-size": "13px",
    "margin-top": "16px",
    "padding": "10px 14px",
  },
  ".import-message.error": {
    "background": "rgba(123, 17, 19, 0.25)",
    "border-color": "rgba(170, 45, 45, 0.55)",
    "color": "#ff8a8a",
  },
  ".import-modal": {
    "z-index": "110",
  },
  ".import-tabs": {
    "border-bottom": "1px solid rgba(201, 162, 74, 0.2)",
    "display": "flex",
    "gap": "4px",
    "margin": "16px 0 18px",
  },
  ".import-tabs button": {
    "background": "transparent",
    "border": "0",
    "border-bottom": "2px solid transparent",
    "color": "var(--muted)",
    "cursor": "pointer",
    "font-family": "inherit",
    "font-size": "12px",
    "font-weight": "800",
    "letter-spacing": "0.12em",
    "padding": "10px 18px",
    "text-transform": "uppercase",
    "transition": "color 0.15s ease, border-color 0.15s ease",
  },
  ".import-tabs button.active": {
    "border-bottom-color": "var(--gold)",
    "color": "var(--gold-bright)",
  },
  ".import-tabs button:hover": {
    "color": "var(--text)",
  },
  ".layout": {
    "display": "grid",
    "gap": "24px",
    "grid-template-columns": "minmax(0, 1fr) 320px",
  },
  ".main-col": {
    "min-width": "0",
  },
  ".modal": {
    "align-items": "center",
    "animation": "fadeIn 0.2s ease-out",
    "backdrop-filter": "blur(12px)",
    "background": "rgba(0, 0, 0, 0.94)",
    "display": "flex",
    "inset": "0",
    "justify-content": "center",
    "padding": "28px",
    "position": "fixed",
    "z-index": "100",
  },
  ".nav-arrow": {
    "background": "rgba(0, 0, 0, 0.7)",
    "border": "1px solid rgba(201, 162, 74, 0.45)",
    "color": "var(--gold-bright)",
    "cursor": "pointer",
    "font-family": "inherit",
    "font-size": "32px",
    "height": "60px",
    "line-height": "1",
    "position": "absolute",
    "top": "50%",
    "transform": "translateY(-50%)",
    "width": "48px",
    "z-index": "102",
  },
  ".nav-arrow.left": {
    "left": "18px",
  },
  ".nav-arrow.right": {
    "right": "18px",
  },
  ".nav-arrow:hover": {
    "background": "rgba(201, 162, 74, 0.1)",
    "border-color": "var(--gold)",
  },
  ".page-btn": {
    "background": "rgba(5, 4, 3, 0.65)",
    "border": "1px solid rgba(201, 162, 74, 0.4)",
    "border-radius": "4px",
    "color": "var(--gold)",
    "cursor": "pointer",
    "font-family": ""Cinzel", serif",
    "font-size": "16px",
    "font-weight": "700",
    "height": "38px",
    "transition": "border-color 200ms, color 200ms, background 200ms, transform 150ms",
    "width": "38px",
  },
  ".page-btn:disabled": {
    "cursor": "not-allowed",
    "opacity": "0.3",
  },
  ".page-btn:hover:not(:disabled)": {
    "background": "rgba(5, 4, 3, 0.85)",
    "border-color": "var(--gold-bright)",
    "color": "var(--gold-bright)",
    "transform": "translateY(-1px)",
  },
  ".page-footer": {
    "border-top": "1px solid rgba(201, 162, 74, 0.2)",
    "color": "var(--muted)",
    "font-size": "12px",
    "line-height": "1.5",
    "margin-top": "48px",
    "padding": "22px",
    "text-align": "center",
  },
  ".page-indicator": {
    "align-items": "center",
    "color": "var(--muted)",
    "display": "inline-flex",
    "flex-direction": "column",
    "font-family": ""Cinzel", serif",
    "font-size": "13px",
    "letter-spacing": "0.1em",
    "padding": "0 14px",
  },
  ".page-indicator strong": {
    "color": "var(--gold-bright)",
    "font-weight": "700",
  },
  ".page-range": {
    "font-size": "11px",
    "letter-spacing": "0.08em",
    "margin-top": "2px",
    "opacity": "0.75",
  },
  ".pagination": {
    "align-items": "center",
    "border-top": "1px solid rgba(201, 162, 74, 0.18)",
    "display": "flex",
    "gap": "8px",
    "justify-content": "center",
    "margin-top": "28px",
    "padding-top": "18px",
  },
  ".panel-head": {
    "align-items": "center",
    "display": "flex",
    "justify-content": "space-between",
    "margin-bottom": "14px",
  },
  ".panel-head h3": {
    "margin": "0",
  },
  ".reddit-card": {
    "background": "rgba(5, 4, 3, 0.6)",
    "border": "1px solid rgba(201, 162, 74, 0.22)",
    "display": "grid",
    "gap": "8px",
    "grid-template-rows": "auto 1fr auto",
    "padding": "10px",
  },
  ".reddit-card.wide": {
    "align-items": "stretch",
    "gap": "14px",
    "grid-template-columns": "200px 1fr",
    "grid-template-rows": "auto",
  },
  ".reddit-grid": {
    "display": "grid",
    "gap": "12px",
    "grid-template-columns": "repeat(auto-fill, minmax(220px, 1fr))",
  },
  ".reddit-info": {
    "display": "flex",
    "flex-direction": "column",
    "gap": "4px",
    "min-width": "0",
  },
  ".reddit-meta": {
    "color": "var(--muted)",
    "font-size": "11px",
  },
  ".reddit-thumb": {
    "aspect-ratio": "16/10",
    "background-color": "#050403",
    "background-position": "center",
    "background-size": "cover",
    "border": "1px solid rgba(201, 162, 74, 0.18)",
  },
  ".reddit-thumb.large": {
    "aspect-ratio": "1/1",
    "grid-row": "span 2",
  },
  ".reddit-title": {
    "-webkit-box-orient": "vertical",
    "-webkit-line-clamp": "2",
    "color": "var(--text)",
    "display": "-webkit-box",
    "font-size": "13px",
    "font-weight": "600",
    "line-height": "1.3",
    "overflow": "hidden",
  },
  ".reset-btn": {
    "background": "transparent",
    "border": "0",
    "color": "var(--gold)",
    "cursor": "pointer",
    "font-family": "inherit",
    "font-size": "10px",
    "font-weight": "900",
    "letter-spacing": "0.14em",
    "text-transform": "uppercase",
  },
  ".reset-btn:hover": {
    "color": "var(--gold-bright)",
  },
  ".results-count": {
    "color": "var(--gold)",
    "display": "block",
    "font-size": "11px",
    "font-weight": "900",
    "letter-spacing": "0.12em",
    "margin-top": "4px",
    "text-transform": "uppercase",
  },
  ".s-icon": {
    "color": "var(--gold)",
    "font-size": "16px",
    "left": "14px",
    "pointer-events": "none",
    "position": "absolute",
  },
  ".search-bar": {
    "align-items": "center",
    "align-self": "stretch",
    "display": "flex",
    "position": "relative",
  },
  ".search-bar input": {
    "background": "var(--panel)",
    "border": "1px solid rgba(201, 162, 74, 0.32)",
    "color": "var(--text)",
    "font": "inherit",
    "font-size": "14px",
    "height": "44px",
    "outline": "none",
    "padding": "0 18px 0 40px",
    "width": "100%",
  },
  ".search-bar input::placeholder": {
    "color": "var(--muted)",
  },
  ".search-bar input:focus": {
    "border-color": "var(--border-strong)",
  },
  ".search-bar input:focus-visible": {
    "outline": "2px solid var(--gold-bright)",
    "outline-offset": "0",
  },
  ".search-bar-wrap": {
    "align-items": "flex-end",
    "display": "flex",
    "flex-wrap": "wrap",
    "gap": "10px",
    "max-width": "720px",
  },
  ".search-field": {
    "align-items": "flex-start",
    "display": "flex",
    "flex": "1",
    "flex-direction": "column",
    "max-width": "520px",
  },
  ".search-label": {
    "background": "var(--panel)",
    "color": "var(--muted)",
    "font-size": "10px",
    "font-weight": "700",
    "letter-spacing": "0.14em",
    "padding": "5px 10px 4px",
    "text-transform": "uppercase",
  },
  ".section": {
    "margin-bottom": "32px",
  },
  ".section-head": {
    "align-items": "end",
    "display": "flex",
    "gap": "18px",
    "justify-content": "space-between",
    "margin-bottom": "16px",
  },
  ".section-title": {
    "color": "var(--gold-bright)",
    "font-family": "var(--serif)",
    "font-size": "22px",
    "letter-spacing": "0.09em",
    "margin": "0",
    "text-transform": "uppercase",
  },
  ".see-all": {
    "background": "transparent",
    "border": "0",
    "color": "var(--gold)",
    "cursor": "pointer",
    "font-family": "inherit",
    "font-size": "11px",
    "font-weight": "900",
    "letter-spacing": "0.12em",
    "text-transform": "uppercase",
    "transition": "color 0.15s ease",
  },
  ".see-all:hover": {
    "color": "var(--gold-bright)",
  },
  ".side-panel": {
    "background": "linear-gradient(180deg, rgba(19, 15, 11, 0.92), rgba(5, 4, 3, 0.96))",
    "border": "1px solid var(--border)",
    "box-shadow": "0 20px 60px rgba(0, 0, 0, 0.55)",
    "padding": "18px",
  },
  ".side-panel h3": {
    "color": "var(--gold-bright)",
    "font-family": "var(--serif)",
    "font-size": "14px",
    "letter-spacing": "0.09em",
    "margin": "0 0 14px",
    "text-transform": "uppercase",
  },
  ".sidebar": {
    "align-self": "start",
    "display": "grid",
    "gap": "18px",
    "position": "sticky",
    "top": "96px",
  },
  ".sr-only": {
    "clip": "rect(0 0 0 0)",
    "height": "1px",
    "margin": "-1px",
    "overflow": "hidden",
    "position": "absolute",
    "white-space": "nowrap",
    "width": "1px",
  },
  ".stat-card": {
    "background": "var(--panel)",
    "min-width": "92px",
    "padding": "8px 10px",
    "text-align": "center",
  },
  ".stat-icon": {
    "color": "var(--gold)",
    "font-size": "22px",
    "margin-bottom": "6px",
  },
  ".stat-label": {
    "color": "var(--muted)",
    "font-size": "11px",
    "letter-spacing": "0.14em",
    "margin-top": "4px",
    "text-transform": "uppercase",
  },
  ".stat-num": {
    "color": "var(--gold-bright)",
    "font-family": "var(--serif)",
    "font-size": "32px",
    "font-weight": "700",
    "line-height": "1",
  },
  ".vi-actions": {
    "display": "flex",
    "gap": "12px",
    "margin-top": "12px",
  },
  ".vi-btn": {
    "align-items": "center",
    "background": "transparent",
    "border": "1px solid rgba(201, 162, 74, 0.42)",
    "color": "var(--gold-bright)",
    "cursor": "pointer",
    "display": "inline-flex",
    "font-family": "inherit",
    "font-size": "12px",
    "font-weight": "900",
    "gap": "6px",
    "height": "36px",
    "letter-spacing": "0.12em",
    "padding": "0 16px",
    "text-decoration": "none",
    "text-transform": "uppercase",
    "transition": "background 0.15s ease",
  },
  ".vi-btn.ghost": {
    "background": "transparent",
    "border-color": "rgba(201, 162, 74, 0.25)",
    "color": "var(--muted)",
  },
  ".vi-btn.ghost:hover": {
    "border-color": "rgba(201, 162, 74, 0.45)",
    "color": "var(--text)",
  },
  ".vi-btn.on": {
    "border-color": "rgba(255, 92, 107, 0.55)",
    "color": "#ff5c6b",
  },
  ".vi-btn.primary": {
    "background": "rgba(201, 162, 74, 0.18)",
    "border-color": "var(--gold)",
  },
  ".vi-btn.primary:hover": {
    "background": "rgba(201, 162, 74, 0.28)",
  },
  ".vi-btn:hover": {
    "background": "rgba(201, 162, 74, 0.1)",
  },
  ".vi-dot": {
    "color": "var(--muted)",
