    "line-height": "1.05",
    "margin": "0",
    "text-transform": "uppercase",
  },
  ".unit-content p": {
    "-webkit-box-orient": "vertical",
    "-webkit-line-clamp": "2",
    "color": "#c3baaa",
    "display": "-webkit-box",
    "font-size": "12px",
    "line-height": "1.5",
    "margin": "4px 0 0",
    "overflow": "hidden",
  },
  ".unit-extra": {
    "align-items": "center",
    "background": "linear-gradient(180deg, rgba(201, 162, 74, 0.06), rgba(0, 0, 0, 0.92))",
    "border": "1px dashed rgba(201, 162, 74, 0.45)",
    "cursor": "pointer",
    "display": "flex",
    "flex-direction": "column",
    "justify-content": "center",
    "min-height": "280px",
    "padding": "22px 18px",
