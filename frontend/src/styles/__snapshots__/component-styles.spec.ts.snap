  ".unit-extra p": {
    "color": "var(--muted)",
    "font-size": "12px",
    "margin": "0 0 12px",
  },
  ".unit-extra:hover": {
    "border-color": "var(--gold-bright)",
  },
  ".units-grid": {
    "display": "grid",
    "gap": "16px",
    "grid-template-columns": "repeat(auto-fill, minmax(220px, 1fr))",
  },
  ".units-head": {
    "align-items": "center",
    "display": "flex",
    "flex-wrap": "wrap",
    "gap": "4px 16px",
    "justify-content": "space-between",
  },
  ":host": {
    "display": "block",
  },
  "@media (max-width: 1280px) .hero-text": {
    "max-width": "80%",
  },
  "@media (max-width: 1280px) .layout": {
    "grid-template-columns": "1fr",
  },
  "@media (max-width: 1280px) .sidebar": {
    "position": "relative",
    "top": "auto",
  },
  "@media (max-width: 760px) .bible-heroes": {
    "grid-template-columns": "minmax(0, 1fr)",
  },
  "@media (max-width: 760px) .hero": {
    "padding": "26px 22px",
  },
  "@media (max-width: 760px) .hero-text": {
    "max-width": "100%",
  },
  "@media (max-width: 760px) .toolbar": {
    "grid-template-columns": "1fr",
  },
  "@media (max-width: 900px) .lore-cols": {
    "gap": "16px",
    "grid-template-columns": "1fr",
  },
  "@media (max-width: 900px) .lore-grid": {
    "grid-template-columns": "1fr",
  },
  "@media (max-width: 900px) .lore-image": {
    "min-height": "180px",
  },
  "@supports (width: 1cqi) .hero h1": {
    "font-size": "min(clamp(48px, 5.5vw, 92px), 100cqi / (var(--longest-word, 1) * 0.85))",
  },
}
`;

