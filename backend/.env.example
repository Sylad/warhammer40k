# Warhammer 40K Codex — Backend env (NestJS)
# Copie ce fichier en .env et remplis les valeurs.

# Clé API Anthropic — utilisée pour générer/enrichir le lore via Claude
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Port d'écoute
PORT=3001

# Origine autorisée pour le CORS (URL du frontend)
CORS_ORIGIN=http://localhost:4201

# PIN d'écriture (optionnel) — protège les endpoints d'écriture :
# POST /image-import/save, POST /image-meta, POST /units/:id/description,
# POST /series/:id/description, POST /videos/import,
# DELETE /videos/:id.
# Si vide ou non défini, pas de protection (mode dev). Si défini, le
# frontend prompte l'utilisateur à la 1ère écriture et mémorise en
# sessionStorage.
# APP_PIN=4242

# En production sans APP_PIN, le backend refuse de démarrer sauf opt-in
# explicite. À réserver au LAN ou à un public forcé en démo verrouillée.
# ALLOW_NO_PIN=true

# Hôtes forcés en mode démo verrouillée (noms d'hôte, séparés par des virgules).
# Toute requête dont le Host (jamais X-Forwarded-Host, forgeable par le
# client — L22) est l'un de ces noms ou un de leurs sous-domaines (appariement
# exact ou suffixe précédé d'un point, jamais en sous-chaîne) est traitée en mode démo : PIN bypassé, écritures bloquées (403), bannière
# "Mode démo verrouillée" affichée côté UI. Par défaut couvre les quick
# tunnels Cloudflare et le domaine public.
DEMO_FORCED_HOSTS=trycloudflare.com,cfargotunnel.com,warhammer.sladoire.dev

# DEMO_FORCED=true verrouille TOUTE l'instance en démo (lecture seule, PIN
# bypassé), sans dépendre d'aucun en-tête HTTP. Off par défaut.
# DEMO_FORCED=true
